# Copy to .env (never commit .env). Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_ENV=development            # development | production
SECRET_KEY=change-me
DATABASE_URL=postgresql://homeapp:devpass@localhost:5432/home_dev
# Used only by the test-suite; the database is wiped between tests. Use a dedicated DB.
TEST_DATABASE_URL=postgresql://homeapp:devpass@localhost:5432/home_test
# Rate-limit storage. memory:// is per-process; use redis://... if running many workers.
RATELIMIT_STORAGE_URI=memory://
# Set to 0 only for local HTTP development. Must be 1 behind HTTPS in production.
SESSION_COOKIE_SECURE=0
